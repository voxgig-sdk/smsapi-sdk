opam-version: "2.0"
name: "voxgig-smsapi-sdk"
version: "0.0.1"
synopsis: "Smsapi SDK for OCaml (generated by @voxgig/sdkgen)"
maintainer: "Voxgig"
authors: "Voxgig"
license: "MIT"
homepage: "https://github.com/voxgig-sdk/smsapi-sdk"
bug-reports: "https://github.com/voxgig-sdk/smsapi-sdk/issues"
# The generated SDK is dependency-free: it compiles with the stock ocamlc
# (see the Makefile). No opam packages, no dune.
depends: [
  "ocaml" {>= "4.14"}
]
build: [
  [make "build"]
]
