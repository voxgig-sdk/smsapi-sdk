    }
  }

  name: "profile"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /profile/prices"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: "eco"
                k: "query"
                n: "type"
