            media: "application/json"
          }
          s: [
            {
              lit: "profile"
            }
            {
              lit: "prices"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.collection`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /profile"
            source: "openapi3"
            version: 2
          }
