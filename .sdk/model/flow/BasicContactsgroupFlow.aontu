# BasicContactsgroupFlow

main: kit: flow: BasicContactsgroupFlow:
{
  entity: "contactsgroup",
  kind: "basic",
  name: "BasicContactsgroupFlow",
  step: [
    {
      i: {
        ref: "contactsgroup_ref01"
      }

      m: {
        group_id: "group01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "contactsgroup_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "contactsgroup_ref01",
        srcdatavar: "contactsgroup_ref01_data",
        suffix: "_up0"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-contactsgroup_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "contactsgroup_ref01",
        suffix: "_rm0"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "contactsgroup_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicContactsgroupFlow"
